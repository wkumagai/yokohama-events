<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  一覧の配信（MBP）。ポート 8788 で本番の作業ツリー（~/yokohama-events）を配る。
  雛形: deploy/install.sh が __HOME__ をこの Mac の $HOME に置き換えて ~/Library/LaunchAgents へ置く（docs/runbook.md の「デプロイ」）。
  解釈系は Homebrew の /opt/homebrew/bin/python3.12（2026-11-26 まで macOS 付属の /usr/bin/python3〔3.9〕。yokohama-events#8）。
-->
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.kuma.yokohama-events</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3.12</string>
		<string>-m</string>
		<string>http.server</string>
		<string>8788</string>
		<string>--directory</string>
		<string>__HOME__/yokohama-events</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/yokohama-events-server.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/yokohama-events-server.log</string>
</dict>
</plist>
